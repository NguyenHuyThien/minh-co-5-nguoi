<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivAvatarTT"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMaTT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiểu thương TT-01"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKhuVucNho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Rau củ"
                    android:textColor="#475569"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHoTenTT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chủ sạp: Cô Tư Rau"
                android:textColor="#475569"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSdtTT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SĐT: 0901 234 501"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLyDoTT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lý do: Nghỉ phép cá nhân"
                android:textColor="#B91C1C"
                android:textSize="11sp"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTrangThaiTT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DCFCE7"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Hoạt động"
            android:textColor="#15803D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.cardview.widget.CardView>